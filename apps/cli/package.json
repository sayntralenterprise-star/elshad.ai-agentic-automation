{
  "name": "@elshad/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentctl": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@elshad/domain": "workspace:*",
    "@elshad/sdk-ts": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

{
  "name": "elshad-ai-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sayntralenterprise-star/elshad.ai-agentic-automation.git"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs --output-type err-long",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "openapi:generate": "pnpm --filter @elshad/api-contract openapi:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}

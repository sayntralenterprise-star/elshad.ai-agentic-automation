{
  "name": "@elshad/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@elshad/authz": "workspace:*",
    "@elshad/domain": "workspace:*",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "openapi:generate": "tsx src/generate.ts"
  }
}

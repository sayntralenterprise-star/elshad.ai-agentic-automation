# ==============================================================================
# Elshad AI Agent & Automation Platform — Docker Compose Environment Defaults
# Matches packages/config/src/index.ts and PRD Appendix O.4
# ==============================================================================

# --- Compose infrastructure ---------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=platform
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Required platform runtime variables (O.4) --------------------------------
PLATFORM_BASE_URL=http://localhost:3000
PLATFORM_DB_URL=postgres://platform_app:platform_app_dev@postgres:5432/platform
PLATFORM_DB_POOL_MAX=40
PLATFORM_REDIS_URL=redis://redis:6379
PLATFORM_NATS_URL=nats://nats:4222
PLATFORM_OBJECT_STORE_URL=http://minio:9000
PLATFORM_OBJECT_STORE_BUCKET=platform-artifacts
PLATFORM_OBJECT_STORE_ACCESS_KEY=minioadmin
PLATFORM_OBJECT_STORE_SECRET_KEY=minioadmin
PLATFORM_OBJECT_STORE_REGION=us-east-1

# Root key for envelope encryption (minimum 32 characters; replace in production)
PLATFORM_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Alternative KMS key ID when using cloud KMS
# PLATFORM_KMS_KEY_ID=
PLATFORM_SECRETS_PROVIDER=db

# --- Bootstrap admin (first boot in Compose mode) -----------------------------
PLATFORM_ADMIN_EMAIL=admin@elshad.local
PLATFORM_ADMIN_PASSWORD=ChangeMe123!
PLATFORM_LOCAL_AUTH_ENABLED=true

# --- OIDC (required in production; optional in Compose) -----------------------
PLATFORM_OIDC_ISSUER=
PLATFORM_OIDC_CLIENT_ID=
PLATFORM_OIDC_CLIENT_SECRET=

# --- Edition & licensing ------------------------------------------------------
PLATFORM_EDITION=community
PLATFORM_LICENSE_KEY=

# --- Observability & logging --------------------------------------------------
# Set to http://otel-collector:4318 when using `--profile observability`
PLATFORM_OTLP_ENDPOINT=
PLATFORM_LOG_LEVEL=info
PLATFORM_TELEMETRY_OPTOUT=false

# --- API, Engine & Worker settings --------------------------------------------
PLATFORM_API_PORT=8080
PLATFORM_ENGINE_PORT=8081
PLATFORM_API_KEY_PEPPER=dev-local-pepper-change-in-prod
PLATFORM_CORS_ORIGIN=http://localhost:3000
PLATFORM_SANDBOX_MODE=docker
PLATFORM_EGRESS_PROXY_URL=
PLATFORM_SMTP_URL=
PLATFORM_WORKER_QUEUES=default
PLATFORM_WORKER_CONCURRENCY=8
PLATFORM_FEATURE_FLAGS=
